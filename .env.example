# Copy to .env:  cp .env.example .env   then edit.
#
# REQUIRED — set your own unique password. The daemon refuses to start if this
# is empty or left as the retired public placeholder.
PASEO_PASSWORD=

# ---- Docker mode only ----
# Image to run: "agent-devbox" (multi-agent, default) or "agent-devbox-core" (lean base).
IMAGE=ghcr.io/sfhgknsdfksdlf/agent-devbox:latest
# REQUIRED — explicit persistence root. There is NO default and no "./data"
# fallback: compose refuses to start when this is unset or empty. Create these
# directories before `docker compose up` (create_host_path is disabled):
#   ${DATA_DIR}/home    -> /home
#   ${DATA_DIR}/root    -> /root
#   ${DATA_DIR}/project -> /workspace
# ${DATA_DIR} is also mounted read-only at /run/agent-devbox/data; the
# entrypoint verifies each bind's stat %d:%i against it and fails closed before
# writing anything when they do not match.
DATA_DIR=
# Timezone
TZ=Asia/Shanghai

# Optional: extra allowed hostnames for the daemon (comma/space separated DNS names).
# Needed when you reach paseo via a DNS name / reverse proxy, e.g. "paseo.example.com,.lan".
# PASEO_HOSTNAMES=paseo.example.com,.lan

# ---- Optional provider credentials (or log in inside the container) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
