# Copy to .env:  cp .env.example .env   then edit.
#
# REQUIRED — the paseo daemon refuses to listen unless a password is set.
PASEO_PASSWORD=change-me-please

# ---- Docker mode only ----
# Image to run: "agent-devbox" (multi-agent, default) or "agent-devbox-core" (lean base).
IMAGE=ghcr.io/sfhgknsdfksdlf/agent-devbox:latest
# Persistence root; subdirs home/ and project/ are bind-mounted in.
DATA_DIR=./data
# Timezone
TZ=Asia/Shanghai

# Optional: extra allowed hostnames for the daemon (comma/space separated DNS names).
# Needed when you reach paseo via a DNS name / reverse proxy, e.g. "paseo.example.com,.lan".
# PASEO_HOSTNAMES=paseo.example.com,.lan

# ---- Optional provider credentials (or log in inside the container) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
